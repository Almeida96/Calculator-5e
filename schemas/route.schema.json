{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calculator 5e route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "legs"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "unit": {
      "enum": [
        "mi",
        "km"
      ],
      "default": "mi"
    },
    "pace": {
      "enum": [
        "slow",
        "normal",
        "fast",
        "custom"
      ],
      "default": "normal"
    },
    "hours_per_day": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 24,
      "default": 8
    },
    "basis": {
      "enum": [
        "daily",
        "hourly"
      ],
      "default": "daily"
    },
    "custom_speed": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "distance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
          },
          "distance": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "terrain": {
            "enum": [
              "normal",
              "difficult"
            ],
            "default": "normal"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pace": {
            "const": "custom"
          }
        },
        "required": [
          "pace"
        ]
      },
      "then": {
        "required": [
          "custom_speed"
        ]
      },
      "else": {
        "not": {
          "required": [
            "custom_speed"
          ]
        }
      }
    }
  ]
}
